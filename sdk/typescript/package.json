{
  "name": "@lumniverse/sdk",
  "version": "0.3.0",
  "description": "TypeScript client for the Lumni coordination protocol",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@langchain/langgraph": "^1.4.14",
    "@openai/agents": "^0.18.0",
    "typescript": "5.9.2",
    "zod": "^4.6.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./langgraph": {
      "types": "./dist/langgraph.d.ts",
      "import": "./dist/langgraph.js"
    },
    "./openai": {
      "types": "./dist/openai.d.ts",
      "import": "./dist/openai.js"
    }
  },
  "peerDependencies": {
    "@langchain/langgraph": "^1.4.14",
    "@openai/agents": "^0.18.0"
  },
  "peerDependenciesMeta": {
    "@langchain/langgraph": {
      "optional": true
    },
    "@openai/agents": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lumnihq/lumni",
    "directory": "sdk/typescript"
  },
  "homepage": "https://lumniverse.com"
}
