# The Lumni console. Copy to .env and fill in.

# Where the Lumni API is. Real data needs it to answer /v1/health/ready.
LUMNI_API_URL=http://localhost:8080

# The admin key this console's server trades for a browser session. It never
# reaches the browser. Leave empty to make people paste their own API key.
LUMNI_CONSOLE_ADMIN_KEY=

# Which data a first visit shows: mock (the demo) or real (your workspace).
LUMNI_CONSOLE_DATA_MODE=mock

# Sign in with the admin key on the first visit, without a click.
LUMNI_CONSOLE_AUTO_SIGN_IN=true

# What to call the workspace; the API doesn't say.
LUMNI_CONSOLE_WORKSPACE_NAME=

# What Lumni costs per checked action, in dollars. Money shows a return only
# when this is set.
LUMNI_CONSOLE_PRICE_PER_ACTION=

# The Lumni API URL your agents use, when it differs from LUMNI_API_URL (for
# example, the console reaches Lumni inside Docker but agents use a public name).
# The onboarding command at /init sends agents here.
LUMNI_CONSOLE_PUBLIC_API_URL=

# This console's public address, for the onboarding command (it trades codes
# here). Defaults to the address the browser used.
LUMNI_CONSOLE_PUBLIC_URL=

# Extra host names this console answers on, comma separated.
LUMNI_CONSOLE_HOSTS=

PORT=5200
