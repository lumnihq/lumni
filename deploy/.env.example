# Lumni, self-hosted. Copy to .env, fill in the secrets, then: docker compose up -d
# Keep .env private: it holds the keys to your workspace.

# Which images to run (ghcr.io/lumnihq/lumni and lumni-console).
LUMNI_VERSION=latest

# ─── Secrets: fill these in ─────────────────────────
# Generate each with: openssl rand -hex 32
# The admin key is how the console talks to the API; start it with lumni_.
LUMNI_ADMIN_KEY=
LUMNI_SECRET_ENCRYPTION_KEY=
LUMNI_CONSOLE_SECRET=
POSTGRES_PASSWORD=

# ─── Where people and agents reach Lumni ────────────
# On this machine (the default):
LUMNI_APP_URL=http://localhost:5200
LUMNI_API_URL=http://localhost:8080
LUMNI_APP_HOST=localhost:5200
LUMNI_BIND=127.0.0.1

# On a server with a domain, with HTTPS from Caddy, use instead:
#   COMPOSE_PROFILES=https
#   LUMNI_APP_URL=https://app.example.com
#   LUMNI_API_URL=https://api.example.com
#   LUMNI_APP_HOST=app.example.com
#   LUMNI_API_HOST=api.example.com
# and point both names' DNS at the server, with ports 80 and 443 open.

LUMNI_WORKSPACE_NAME=My workspace

# ─── Optional ───────────────────────────────────────
# Sign in with GitHub or Google (OAuth apps; the callback URL is
# $LUMNI_APP_URL/console/auth/oauth/github/callback, or .../google/callback).
LUMNI_GITHUB_CLIENT_ID=
LUMNI_GITHUB_CLIENT_SECRET=
LUMNI_GOOGLE_CLIENT_ID=
LUMNI_GOOGLE_CLIENT_SECRET=

# Email for alerts (STARTTLS), and Slack through Composio.
LUMNI_SMTP_ADDR=
LUMNI_SMTP_FROM=
LUMNI_SMTP_USER=
LUMNI_SMTP_PASSWORD=
LUMNI_COMPOSIO_API_KEY=
LUMNI_COMPOSIO_SLACK_AUTH_CONFIG_ID=

# ClickHouse for analytics at large volume: add analytics to COMPOSE_PROFILES,
# then set LUMNI_ANALYTICS_BACKEND=clickhouse and a password.
CLICKHOUSE_PASSWORD=
