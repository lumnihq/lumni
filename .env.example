LUMNI_DATABASE_URL=postgres://lumni:lumni@postgres:5432/lumni?sslmode=disable
LUMNI_HTTP_ADDR=:8080
LUMNI_OTLP_HTTP_ADDR=:4318
LUMNI_OTLP_GRPC_ADDR=:4317
# Optional host-side Compose port overrides.
LUMNI_HTTP_PORT=8080
LUMNI_POSTGRES_PORT=5432
LUMNI_OTLP_HTTP_PORT=4318
LUMNI_OTLP_GRPC_PORT=4317
LUMNI_BOOTSTRAP_TENANT_NAME=Local Development
LUMNI_BOOTSTRAP_TENANT_SLUG=local
LUMNI_BOOTSTRAP_ADMIN_KEY=lumni_local_change_me
LUMNI_MODE=SHADOW
LUMNI_LEASE_TTL=30s
LUMNI_GITHUB_WEBHOOK_SECRET=
LUMNI_GITHUB_API_TOKEN=
LUMNI_GITHUB_API_URL=https://api.github.com
LUMNI_SECRET_ENCRYPTION_KEY=local-development-secret-change-me
LUMNI_LOG_LEVEL=info
LUMNI_CONSOLE_DIR=/var/lib/lumni/console
LUMNI_SESSION_IDLE_TTL=8h
LUMNI_SESSION_ABSOLUTE_TTL=24h

# Optional advisory semantic evaluation. The worker remains deterministic when
# this is off (the default). Tenants must also opt in through the API.
LUMNI_SEMANTIC_PROVIDER=off
LUMNI_OPENROUTER_API_KEY=
LUMNI_JEV_MODEL=typesafe/jev-1.13
LUMNI_SEMANTIC_TIMEOUT=5s
LUMNI_SEMANTIC_MAX_RETRIES=3
LUMNI_SEMANTIC_MAX_CANDIDATES=20

# PostgreSQL remains authoritative. `auto` uses ClickHouse only when the
# optional analytics profile is healthy at startup.
LUMNI_ANALYTICS_BACKEND=auto
LUMNI_ANALYTICS_TIMEOUT=5s
LUMNI_CLICKHOUSE_URL=http://clickhouse:8123
LUMNI_CLICKHOUSE_DATABASE=lumni
LUMNI_CLICKHOUSE_USER=default
LUMNI_CLICKHOUSE_PASSWORD=lumni
LUMNI_CLICKHOUSE_HTTP_PORT=8123
LUMNI_CLICKHOUSE_NATIVE_PORT=9000

# Optional public proof links and notification transports.
LUMNI_PUBLIC_BASE_URL=http://localhost:8080
LUMNI_COMPOSIO_API_KEY=
LUMNI_COMPOSIO_SLACK_AUTH_CONFIG_ID=
LUMNI_SMTP_ADDR=
LUMNI_SMTP_FROM=
LUMNI_SMTP_USER=
LUMNI_SMTP_PASSWORD=
